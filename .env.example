# Browser-safe Supabase values. The publishable key is intentionally public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only pooled Postgres connection. Use Supavisor transaction mode.
DATABASE_URL=postgresql://postgres.your-project-ref:password@region.pooler.supabase.com:6543/postgres?sslmode=require

# Server-only secret for future administrative Auth operations.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

NEXT_PUBLIC_APP_URL=http://localhost:3000
